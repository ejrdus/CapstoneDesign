# ───────────────────────────────────────────────
# 필수
# ───────────────────────────────────────────────
# Anthropic Claude API Key (https://console.anthropic.com/settings/keys 에서 발급)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ───────────────────────────────────────────────
# 서버
# ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# 리버스 프록시 뒤에 있을 때 1 (Express trust proxy)
TRUST_PROXY=0

# ───────────────────────────────────────────────
# 분석 API 보호 (선택)
# ───────────────────────────────────────────────
# 설정 시 /api/analyze 호출에 이 키를 요구
ANALYZE_API_KEY=
# 분석 엔드포인트 분당 요청 제한
ANALYZE_RATE_LIMIT_MAX=60
RATE_LIMIT_MAX=120

# ───────────────────────────────────────────────
# 관리자 대시보드 인증
# ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# 세션 토큰 서명용 시크릿 (긴 랜덤 문자열로 교체)
JWT_SECRET=change_this_to_a_long_random_string

# ───────────────────────────────────────────────
# 데이터/프라이버시
# ───────────────────────────────────────────────
# IP 해싱용 솔트 (랜덤 문자열로 교체)
IP_HASH_SALT=change_this_to_a_random_salt
# 분석 로그 보관 일수
DATABASE_RETENTION_DAYS=30
